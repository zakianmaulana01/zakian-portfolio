# Set to the final public domain when deploying.
# Vercel production URLs are detected automatically when available.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Gemini credentials. Never prefix these with NEXT_PUBLIC_.
GEMINI_API_KEY=replace_with_a_new_rotated_key
GEMINI_MODEL=gemini-3.5-flash-lite
